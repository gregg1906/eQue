# Skopiuj do .env (plik .env jest w .gitignore) i ustaw własne wartości.
# Bez pliku .env docker-compose użyje domyślnych ustawień deweloperskich.

# Baza danych. Uwaga: Postgres ustawia hasło tylko przy pierwszym utworzeniu wolumenu
# pgdata — zmiana hasła przy istniejącej bazie wymaga ALTER USER albo nowego wolumenu.
POSTGRES_USER=admin
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=eque_db

# Klucz podpisu tokenów JWT — WYMAGANY, min. 32 bajty; bez niego backend nie startuje.
# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Tryb deweloperski: pozwala uruchomić backend bez JWT_SECRET_KEY (klucz zastępczy).
# Tylko na własnym komputerze — na serwerze zostaw puste.
APP_ENV=

# Pierwsze konto administratora (tworzone tylko na pustej bazie). Hasło min. 12 znaków,
# nie może być popularne ani równe loginowi.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Dane demonstracyjne (operatorzy, lokalizacje, tablety, bilety; konto admin dostaje hasło
# ADMIN_INITIAL_PASSWORD albo admin123, jeśli go nie ustawisz). Ustaw 1 tylko do rozwoju i pokazów.
SEED_DEMO_DATA=

# Strefa czasowa placówki — od niej zależy, o której zaczyna się numeracja biletów (A01…)
APP_TIMEZONE=Europe/Warsaw

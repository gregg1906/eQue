# Skopiuj do .env (plik .env jest w .gitignore) i ustaw własne wartości.
# Bez pliku .env docker-compose użyje domyślnych ustawień deweloperskich.

# Baza danych. Uwaga: Postgres ustawia hasło tylko przy pierwszym utworzeniu wolumenu
# pgdata — zmiana hasła przy istniejącej bazie wymaga ALTER USER albo nowego wolumenu.
POSTGRES_USER=admin
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=eque_db

# Klucz podpisu tokenów JWT — długi, losowy ciąg, np. wynik: openssl rand -hex 32
JWT_SECRET_KEY=

# Strefa czasowa placówki — od niej zależy, o której zaczyna się numeracja biletów (A01…)
APP_TIMEZONE=Europe/Warsaw
